// Date Table Creation
Date Table = CALENDAR(MIN('Hospital ER_Data'[Patient Admission Date]), MAX('Hospital ER_Data'[Patient Admission Date]))

// New Columns for Date Table
Month Name = FORMAT('Date Table'[Date], "MMM")
Year = YEAR('Date Table'[Date])

// --- Calculated Columns to Fix Joins ---

// Create a date-only column in the main 'Hospital ER_Data' table 
// to ensure a correct relationship with the 'Date Table'[Date] field.
Admission Date (Date Only) = INT('Hospital ER_Data'[Patient Admission Date])

// --- KPI Measures ---

// Total Patients (Calculated value for metrics)
Total Patients = COUNTROWS('Hospital ER_Data')

// Total Patients (Formatted for display, e.g., "9217" instead of "9K")
Total Patients Display = FORMAT([Total Patients], "#,##0")

// Average Wait Time
Average Wait Time = AVERAGE('Hospital ER_Data'[Wait Time])

// Average Satisfaction Score
Average Satisfaction Score = AVERAGE('Hospital ER_Data'[Patient satisfaction score])

// Total Referrals
Total Referrals = COUNT('Hospital ER_Data'[Department Referral])

// --- New Calculated Columns ---

// Admission Status (IF admission flag is true then "Admitted" else "Not Admitted")
Admission Status = IF('Hospital ER_Data'[Admission Flag] = TRUE(), "Admitted", "Not Admitted")

// Note: Ensure the relationship is established between 'Hospital ER_Data'[Admission Date (Date Only)] and 'Date Table'[Date].
